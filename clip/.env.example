CLIP_API_KEY=change-me
CLIP_STORAGE_ROOT=/data/clips
DATABASE_URL=postgresql+psycopg://clip:clip@postgres:5432/clip
REDIS_URL=redis://redis:6379/0
CLIP_LANGUAGE=ru
CLIP_MIN_SECONDS=15
CLIP_MAX_SECONDS=90
CLIP_COUNT=5
WHISPER_MODEL=small
CLIP_WHISPER_DEVICE=auto
CLIP_WHISPER_COMPUTE_TYPE=auto
CLIP_VIDEO_ENCODER=auto
CLIP_REQUIRE_GPU=false
CLIP_MAX_UPLOAD_MB=2048
CLIP_DOWNLOAD_TIMEOUT=1800
CLIP_MIN_FREE_MB=2048
CLIP_FFMPEG_TIMEOUT=3600
CLIP_FACE_TRACKING=true
CLIP_FACE_SAMPLE_SECONDS=1.0
CLIP_SUBTITLE_FONT=DejaVu Sans
CLIP_SUBTITLE_FONT_SIZE=18
CLIP_RETENTION_DAYS=30
CLIP_STALE_MINUTES=120
CLIP_MAX_ATTEMPTS=4
CLIP_OLLAMA_URL=http://127.0.0.1:11434
CLIP_OLLAMA_MODEL=qwen3-vl:4b-instruct
CLIP_PIPER_MODEL=./models/ru_RU-denis-medium.onnx
CLIP_VOICE_GAIN=1.6
CLIP_VOICEOVER_QUEUE=false
